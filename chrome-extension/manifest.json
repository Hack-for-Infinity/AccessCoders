{
  "manifest_version": 3,
  "name": "AccessScholar Accessibility Tools",
  "description": "Adds accessibility features to scholarship websites.",
  "version": "1.0",

  "permissions": ["activeTab", "scripting"],

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}